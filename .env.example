# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=advanced_rag_docs

# Embeddings (fastembed, run locally, no API key needed)
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
DENSE_VECTOR_SIZE=384

# Chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=60
PARENT_CHUNK_SIZE=1600
PARENT_CHUNK_OVERLAP=100

# Retrieval
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=5
RRF_K=60

# Reranker
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM — required for query rewriting, multi-query, GraphRAG extraction,
# adaptive routing classification, and answer synthesis. Retrieval-only
# features (basic/hybrid search, reranking, parent expansion) work without it.
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

DATA_DIR=data/sample_docs
